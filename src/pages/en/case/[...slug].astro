---
import { render } from 'astro:content';
import CaseLayout from '@/layouts/CaseLayout.astro';
import { getSortedCases, caseSlug } from '@/lib/cases';

export async function getStaticPaths() {
  const cases = await getSortedCases('en');

  return cases.map((entry, index) => ({
    params: { slug: caseSlug(entry) },
    props: { entry, prev: cases[index - 1], next: cases[index + 1] },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---

<CaseLayout entry={entry} prev={prev} next={next} lang="en">
  <Content />
</CaseLayout>
