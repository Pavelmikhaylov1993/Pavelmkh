---
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { defaultLocale, t, type Locale } from '@/lib/i18n';

interface Props {
  title: string;
  description: string;
  lang?: Locale;
  /** Путь страницы от корня сайта без base и без языкового префикса — см. BaseHead. */
  path?: string;
  ogImage?: string;
}

const { title, description, lang = defaultLocale, path, ogImage } = Astro.props;
---

<!doctype html>
<html lang={t(lang).htmlLang}>
  <head>
    <BaseHead title={title} description={description} lang={lang} path={path} ogImage={ogImage} />
  </head>
  <body class="min-h-dvh">
    <Header lang={lang} path={path} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
