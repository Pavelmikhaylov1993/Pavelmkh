---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/utils';
import { profile } from '@/lib/site';
import { caseSlug } from '@/lib/cases';
import { defaultLocale, localePath, t, type Locale } from '@/lib/i18n';
import { Lightbox } from '@/components/react/Lightbox';

interface Props {
  entry: CollectionEntry<'cases'>;
  prev?: CollectionEntry<'cases'>;
  next?: CollectionEntry<'cases'>;
  lang?: Locale;
}

const { entry, prev, next, lang = defaultLocale } = Astro.props;
const { title, company, role, outcome, metrics, summary } = entry.data;
const strings = t(lang);
---

<BaseLayout
  title={`${company} — ${title} · ${profile(lang).name}`}
  description={summary}
  lang={lang}
  path={`/case/${caseSlug(entry)}/`}
>
  <article class="mx-auto max-w-3xl px-4 py-12 md:py-16">
    <a
      href={withBase(`${localePath(lang, '/')}#cases`)}
      class="text-sm text-muted-foreground hover:text-foreground"
    >
      {strings.backToCases}
    </a>

    <p data-testid="case-company" class="mt-8 text-sm text-muted-foreground">{company}</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight md:text-5xl">{title}</h1>

    <dl class="mt-8 grid gap-4 border-y py-6 sm:grid-cols-2">
      <div>
        <dt class="text-sm text-muted-foreground">{strings.myRole}</dt>
        <dd data-testid="case-role" class="mt-1">{role.join(', ')}</dd>
      </div>
      <div>
        <dt class="text-sm text-muted-foreground">{strings.outcome}</dt>
        <dd data-testid="case-outcome" class="mt-1">{outcome}</dd>
      </div>
    </dl>

    {metrics.length > 0 && (
      <dl class="mt-8 grid gap-6 sm:grid-cols-2">
        {metrics.map((metric) => (
          <div>
            <dt class="text-3xl font-semibold tabular-nums">{metric.value}</dt>
            <dd class="mt-1 text-sm text-muted-foreground">{metric.label}</dd>
          </div>
        ))}
      </dl>
    )}

    <div class="prose-case mt-12">
      <Lightbox
        client:visible
        fallbackTitle={strings.lightboxFallback}
        closeLabel={strings.lightboxClose}
      />
      <slot />
    </div>

    <nav class="mt-16 flex justify-between gap-4 border-t pt-8 text-sm">
      {prev ? (
        <a
          href={withBase(localePath(lang, `/case/${caseSlug(prev)}/`))}
          class="hover:underline"
        >
          {strings.prevCase}
        </a>
      ) : (
        <span></span>
      )}
      {next && (
        <a
          href={withBase(localePath(lang, `/case/${caseSlug(next)}/`))}
          class="text-right hover:underline"
        >
          {strings.nextCase}
        </a>
      )}
    </nav>
  </article>
</BaseLayout>
